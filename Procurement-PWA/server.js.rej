+// Document versioning: only the newest version in each chain should show
+// up in list views (my-inbox/my-outbox/filter-options) — older, superseded
+// versions stay individually reachable via GET /documents/:id/versions,
+// but shouldn't clutter the active lists. No bound params needed, so this
+// can just be pushed straight into a `conditions` array.
+const LATEST_VERSION_ONLY_CLAUSE = `NOT EXISTS (
+    SELECT 1 FROM documents newer
+    WHERE COALESCE(newer.version_group_id, newer.id) = COALESCE(d.version_group_id, d.id)
+      AND newer.version_number > d.version_number
+)`;

+  function setUploadSource(mode) {
+    uploadSource = mode;
+    const computerBtn = document.getElementById('sourceComputerBtn');
+    const driveBtn = document.getElementById('sourceDriveBtn');
+    const computerGroup = document.getElementById('computerFileGroup');
+    const driveGroup = document.getElementById('driveFileGroup');
+    const fileInput = document.getElementById('documentFileInput');
+
+    const activeStyle = 'flex:1;padding:8px;border-radius:6px;border:1px solid var(--steel);background:var(--steel);color:#fff;font-weight:600;cursor:pointer;';
+    const inactiveStyle = 'flex:1;padding:8px;border-radius:6px;border:1px solid var(--border-strong);background:var(--bg-muted);color:var(--text-secondary);font-weight:600;cursor:pointer;';
+
+    if (mode === 'drive') {
+      computerBtn.style.cssText = inactiveStyle;
+      driveBtn.style.cssText = activeStyle + 'display:block;';
+      computerGroup.style.display = 'none';
+      driveGroup.style.display = 'block';
+      fileInput.required = false;
+    } else {
+      computerBtn.style.cssText = activeStyle;
+      driveBtn.style.cssText = inactiveStyle + (driveBtn.dataset.available === '1' ? 'display:block;' : 'display:none;');
+      computerGroup.style.display = 'block';
+      driveGroup.style.display = 'none';
+      fileInput.required = true;
+    }
+  }

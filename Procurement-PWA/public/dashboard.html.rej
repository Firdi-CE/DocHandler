+  // --- Document versioning: resubmit a rejected document ---
+
+  function waitForDropdownReady(selectId, maxWaitMs) {
+    maxWaitMs = maxWaitMs || 3000;
+    return new Promise(resolve => {
+      const start = Date.now();
+      (function check() {
+        const el = document.getElementById(selectId);
+        if (el && el.options.length > 1) return resolve();
+        if (Date.now() - start > maxWaitMs) return resolve(); // give up gracefully; prefill just won't apply
+        setTimeout(check, 100);
+      })();
+    });
+  }
+
+  async function startResubmit(docId) {
+    const doc = allDocs.find(d => d.id === docId);
+    if (!doc) return;
+    resubmitContext = { originalId: docId, filename: doc.filename };
+
+    showView('upload');
+    await waitForDropdownReady('uploadProjectDropdown');
+
+    document.getElementById('uploadProjectDropdown').value = doc.project_id || '';
+    await loadUploadSites();
+    if (doc.site_id) document.getElementById('uploadSiteDropdown').value = doc.site_id;
+    document.getElementById('uploadDeptDropdown').value = doc.department_id || '';
+    await loadUploadUsers();
+    if (doc.recipient_id) document.getElementById('uploadPicDropdown').value = doc.recipient_id;
+    document.getElementById('urgentCheckbox').checked = !!doc.is_urgent;
+
+    // Nice-to-have, not required: default to the same source the original
+    // used, if that source is still available.
+    if (doc.drive_attachment_id && document.getElementById('sourceDriveBtn').dataset.available === '1') {
+      setUploadSource('drive');
+    }
+
+    showResubmitBanner(doc.filename);
+  }
+
+  function showResubmitBanner(filename) {
+    let banner = document.getElementById('resubmitBanner');
+    if (!banner) {
+      banner = document.createElement('div');
+      banner.id = 'resubmitBanner';
+      banner.style.cssText = 'background:#FEF3C7;border:1px solid #F59E0B;color:#92400E;padding:8px 12px;border-radius:6px;margin-bottom:1rem;font-size:0.85rem;display:flex;justify-content:space-between;align-items:center;gap:8px;';
+      document.getElementById('uploadForm').prepend(banner);
+    }
+    banner.innerHTML = `<span>Resubmitting a corrected version of <strong>${escapeHtml(filename)}</strong></span>`;
+    const cancelBtn = document.createElement('button');
+    cancelBtn.type = 'button';
+    cancelBtn.textContent = 'Cancel';
+    cancelBtn.style.cssText = 'background:none;border:none;color:#92400E;text-decoration:underline;cursor:pointer;font-size:0.85rem;';
+    cancelBtn.onclick = cancelResubmit;
+    banner.appendChild(cancelBtn);
+  }
+
+  function cancelResubmit() {
+    clearResubmitState();
+    document.getElementById('uploadForm').reset();
+    resetUploadUI();
+  }
+
+  function clearResubmitState() {
+    resubmitContext = null;
+    const banner = document.getElementById('resubmitBanner');
+    if (banner) banner.remove();
+  }
+
+  // --- Document versioning: view history ---
+
+  async function openVersionsModal(docId, filename) {
+    document.getElementById('versionsModalTitle').textContent = 'Version History — ' + filename;
+    document.getElementById('versionsModal').classList.add('open');
+    const listEl = document.getElementById('versionsList');
+    listEl.innerHTML = '<p style="color:var(--text-muted);font-size:0.85rem;text-align:center;padding:1rem;">Loading...</p>';
+    try {
+      const res = await fetch(API_BASE + '/documents/' + docId + '/versions', {
+        headers: { 'Authorization': 'Bearer ' + token }
+      });
+      const versions = await res.json();
+      if (!res.ok || !Array.isArray(versions) || versions.length === 0) {
+        listEl.innerHTML = '<p style="color:var(--text-muted);font-size:0.85rem;text-align:center;padding:1rem;">No version history.</p>';
+        return;
+      }
+      listEl.innerHTML = versions.map(v => `
+        <div style="padding:10px;border-bottom:1px solid var(--border);">
+          <div style="display:flex;justify-content:space-between;align-items:center;">
+            <strong style="font-size:0.85rem;">v${v.version_number} — ${escapeHtml(v.filename)}</strong>
+            ${getStatusBadge(v.status)}
+          </div>
+          <div style="font-size:0.78rem;color:var(--text-muted);margin-top:2px;">
+            ${escapeHtml(v.sender_name || '—')} · ${formatTimestamp(v.created_at)}
+          </div>
+          ${v.notes ? `<div style="font-size:0.8rem;margin-top:4px;font-style:italic;">"${escapeHtml(v.notes)}"</div>` : ''}
+          <div style="margin-top:6px;">
+            <button class="btn btn-view" onclick="viewDocument(${v.id}, '${String(v.filename).replace(/'/g, "\\'")}')">View</button>
+            <button class="btn btn-rename" style="background:var(--steel);color:white;" onclick="downloadDocument(${v.id})">Download</button>
+          </div>
+        </div>
+      `).join('');
+    } catch (e) {
+      listEl.innerHTML = '<p style="color:var(--text-muted);font-size:0.85rem;text-align:center;padding:1rem;">Failed to load version history.</p>';
+    }
+  }
+
+  function closeVersionsModal() {
+    document.getElementById('versionsModal').classList.remove('open');
+  }
+

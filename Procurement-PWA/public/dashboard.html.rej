+  async function loadUploadSites() {
+    const projectId = document.getElementById('uploadProjectDropdown').value;
+    const siteDropdown = document.getElementById('uploadSiteDropdown');
+    if (!projectId) {
+      siteDropdown.innerHTML = '<option value="">-- Choose Project first --</option>';
+      return;
+    }
+    siteDropdown.innerHTML = '<option value="">-- Loading Sites... --</option>';
+    try {
+      const res = await fetch(API_BASE + '/projects/' + projectId + '/sites', {
+        headers: { 'Authorization': 'Bearer ' + token }
+      });
+      const sites = await res.json();
+      siteDropdown.innerHTML = '<option value="">-- No specific site --</option>';
+      sites.forEach(s => {
+        const opt = document.createElement('option');
+        opt.value = s.id; opt.textContent = s.site_name;
+        siteDropdown.appendChild(opt);
+      });
+    } catch (e) {
+      siteDropdown.innerHTML = '<option value="">-- No specific site --</option>';
+    }
+  }
+
+  // --- Attach from Google Drive (Google Drive integration) ---
+  let driveSearchDebounceTimer = null;
+
+  function openDriveBrowseModal() {
+    document.getElementById('driveBrowseModal').classList.add('open');
+    document.getElementById('driveSearchInput').value = '';
+    searchDriveFiles();
+  }
+
+  function closeDriveBrowseModal() {
+    document.getElementById('driveBrowseModal').classList.remove('open');
+  }
+
+  function debouncedDriveSearch() {
+    clearTimeout(driveSearchDebounceTimer);
+    driveSearchDebounceTimer = setTimeout(searchDriveFiles, 350);
+  }
+
+  function escapeHtml(str) {
+    return String(str).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
+  }
+
+  async function searchDriveFiles() {
+    const listEl = document.getElementById('driveFileList');
+    const q = document.getElementById('driveSearchInput').value.trim();
+    listEl.innerHTML = '<p style="color:var(--text-muted);font-size:0.85rem;text-align:center;padding:1rem;">Loading...</p>';
+    try {
+      const url = API_BASE + '/drive/files' + (q ? '?q=' + encodeURIComponent(q) : '');
+      const res = await fetch(url, { headers: { 'Authorization': 'Bearer ' + token } });
+      const data = await res.json();
+      const files = data.files || [];
+      if (files.length === 0) {
+        listEl.innerHTML = '<p style="color:var(--text-muted);font-size:0.85rem;text-align:center;padding:1rem;">No files found.</p>';
+        return;
+      }
+      listEl.innerHTML = files.map(f => `
+        <div class="drive-file-row" data-id="${escapeHtml(f.id)}" data-name="${escapeHtml(f.name)}"
+          style="display:flex;align-items:center;gap:8px;padding:8px;border-radius:6px;cursor:pointer;border-bottom:1px solid var(--border);">
+          <img src="${escapeHtml(f.iconLink || '')}" style="width:18px;height:18px;" onerror="this.style.display='none'">
+          <span style="font-size:0.88rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escapeHtml(f.name)}</span>
+        </div>
+      `).join('');
+    } catch (e) {
+      listEl.innerHTML = '<p style="color:var(--text-muted);font-size:0.85rem;text-align:center;padding:1rem;">Failed to load files.</p>';
+    }
+  }
+
+  // Delegated click handler instead of inline onclick, since Drive file
+  // names are untrusted content and shouldn't be interpolated into
+  // inline JS attributes.
+  document.getElementById('driveFileList').addEventListener('click', (e) => {
+    const row = e.target.closest('.drive-file-row');
+    if (row) selectDriveFile(row.dataset.id, row.dataset.name);
+  });
+
+  function selectDriveFile(id, name) {
+    selectedDriveFile = { id, name };
+    document.getElementById('selectedDriveFileName').textContent = name;
+    document.getElementById('selectedDriveFileName').style.color = 'var(--text-primary)';
+    closeDriveBrowseModal();
+  }
+

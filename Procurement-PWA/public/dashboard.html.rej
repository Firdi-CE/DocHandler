+  async function submitDriveAttach(formEl) {
+    if (!selectedDriveFile) {
+      showUploadError('Choose a file from Drive first.');
+      return;
+    }
+
+    document.getElementById('submitBtn').disabled = true;
+    document.getElementById('submitBtn').textContent = 'Sending...';
+
+    const body = {
+      fileId: selectedDriveFile.id,
+      recipientId: document.getElementById('uploadPicDropdown').value || null,
+      projectId: document.getElementById('uploadProjectDropdown').value || null,
+      siteId: document.getElementById('uploadSiteDropdown').value || null,
+      departmentId: document.getElementById('uploadDeptDropdown').value || null,
+      isUrgent: document.getElementById('urgentCheckbox').checked,
+    };
+    if (resubmitContext) body.resubmitOf = resubmitContext.originalId;
+
+    try {
+      const res = await fetch(API_BASE + '/documents/drive-attach', {
+        method: 'POST',
+        headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
+        body: JSON.stringify(body)
+      });
+      const data = await res.json().catch(() => ({}));
+      document.getElementById('submitBtn').disabled = false;
+      document.getElementById('submitBtn').textContent = 'Send';
+
+      if (res.ok) {
+        showUploadStatus(resubmitContext ? 'Resubmitted successfully!' : 'Document shared from Drive successfully!', 'success');
+        const landOnSent = !!resubmitContext;
+        clearResubmitState();
+        setTimeout(async () => {
+          formEl.reset();
+          selectedDriveFile = null;
+          document.getElementById('selectedDriveFileName').textContent = 'No file selected';
+          document.getElementById('selectedDriveFileName').style.color = 'var(--text-muted)';
+          setUploadSource('computer');
+          resetUploadUI();
+          showUploadStatus('', '');
+          document.getElementById('uploadStatusMessage').className = 'status-msg';
+          currentTab = landOnSent ? 'sent' : 'inbox';
+          currentPage = 1;
+          document.getElementById('tabInbox').classList.toggle('active', !landOnSent);
+          document.getElementById('tabSent').classList.toggle('active', landOnSent);
+          document.getElementById('filterBar').style.display = 'flex';
+          showView('documents');
+          await loadDocs();
+        }, 900);
+      } else {
+        showUploadError(data.message || `Failed to share file (HTTP ${res.status}).`);
+      }
+    } catch (e) {
+      document.getElementById('submitBtn').disabled = false;
+      document.getElementById('submitBtn').textContent = 'Send';
+      showUploadError('Network error: could not reach the server. Please check your connection.');
+    }
+  }

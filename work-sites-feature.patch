+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Integrations — Admin</title>
+  <link rel="stylesheet" href="/theme.css">
+  <style>
+    body { padding: 2rem; }
+    .card { max-width: 640px; margin: auto; }
+    .status-msg { padding: 0.75rem; border-radius: 8px; margin-bottom: 1rem; display: none; }
+    .status-msg.success { display: block; background: var(--green-bg); border: 1px solid var(--green-border); color: var(--green-text); }
+    .status-msg.error { display: block; background: var(--red-bg); border: 1px solid var(--red-border); color: var(--red-text); }
+    .integration-row { display: flex; align-items: center; justify-content: space-between; padding: 1rem; border: 1px solid var(--border); border-radius: 8px; }
+    .integration-row + .integration-row { margin-top: 1rem; }
+    .integration-name { font-weight: 700; color: var(--navy); }
+    .integration-detail { font-size: 0.85rem; color: var(--text-muted); margin-top: 4px; }
+    .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; }
+    .dot.on { background: #16A34A; }
+    .dot.off { background: #9CA3AF; }
+    .btn-connect { background: var(--steel); color: white; border: none; border-radius: 6px; padding: 8px 16px; cursor: pointer; font-weight: 600; }
+    .btn-connect:hover { background: var(--steel-hover); }
+    .btn-disconnect { background: transparent; color: #B91C1C; border: 1px solid #B91C1C; border-radius: 6px; padding: 8px 16px; cursor: pointer; font-weight: 600; }
+    .btn-disconnect:hover { background: #FEF2F2; }
+    .not-configured-note { font-size: 0.85rem; color: var(--text-muted); background: var(--bg-muted); border: 1px solid var(--border); border-radius: 8px; padding: 0.75rem; margin-top: 1rem; }
+  </style>
+</head>
+<body class="full-bleed">
+
+<div class="app-shell">
+  <aside class="app-sidebar">
+    <div class="sidebar-logo">
+      <img src="/assets/logo.png" alt="Pilar Energi">
+      <span>DocHandler</span>
+    </div>

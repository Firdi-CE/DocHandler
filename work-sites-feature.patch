+      if (user.role !== 'Executive' && user.role !== 'Admin') {
+        window.location.href = '/dashboard.html';
+        return;
+      }
+      loadStatus();
+    } catch (e) { loadStatus(); }
+  })();
+</script>
+
+</body>
+</html>

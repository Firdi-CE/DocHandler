+      const res = await fetch(API_BASE + '/admin/integrations/google-drive/disconnect', {
+        method: 'POST',
+        headers: { 'Authorization': 'Bearer ' + token }
+      });
+      if (res.ok) {
+        showStatus('Google Drive disconnected.', 'success');
+        loadStatus();
+      } else {
+        const data = await res.json();
+        showStatus(data.message || 'Failed to disconnect.', 'error');
+      }
+    } catch (e) {
+      showStatus('Network error while disconnecting.', 'error');
+    }
+  }
+
+  function logout() {
+    localStorage.removeItem('token');
+    localStorage.removeItem('user');
+    window.location.href = '/login.html';
+  }
+
+  function toggleSidebarGroup(submenuId, toggleBtn) {
+    const submenu = document.getElementById(submenuId);
+    const isOpen = submenu.classList.toggle('open');
+    toggleBtn.classList.toggle('open', isOpen);
+  }
+
+  (async () => {
+    try {
+      const res = await fetch('/auth/me', { headers: { 'Authorization': 'Bearer ' + token } });
+      if (res.status === 401) { window.location.href = '/login.html?reason=expired'; return; }

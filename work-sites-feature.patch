+<script>
+  const API_BASE = '';
+  const token = localStorage.getItem('token');
+  if (!token) window.location.href = '/login.html?reason=expired';
+
+  function showStatus(msg, type) {
+    const el = document.getElementById('statusMessage');
+    el.textContent = msg; el.className = 'status-msg ' + type;
+  }
+
+  // Surface the redirect result from the OAuth callback, if any.
+  (function handleRedirectParams() {
+    const params = new URLSearchParams(window.location.search);
+    if (params.get('drive_connected')) {
+      showStatus('Google Drive connected successfully.', 'success');
+    } else if (params.get('drive_error')) {
+      showStatus('Could not connect Google Drive: ' + params.get('drive_error'), 'error');
+    }
+    if (params.toString()) {
+      window.history.replaceState({}, '', '/admin/integrations.html');
+    }
+  })();
+
+  async function loadStatus() {
+    try {
+      const res = await fetch(API_BASE + '/admin/integrations/google-drive/status', {
+        headers: { 'Authorization': 'Bearer ' + token }
+      });
+      if (res.status === 401) { window.location.href = '/login.html?reason=expired'; return; }
+      if (res.status === 403) { window.location.href = '/dashboard.html'; return; }
+      const data = await res.json();
+      render(data);
+    } catch (e) {
+      document.getElementById('driveDetail').textContent = 'Failed to load status.';
+    }
+  }
+
+  function render(data) {
+    const dot = document.getElementById('driveDot');
+    const detail = document.getElementById('driveDetail');
+    const action = document.getElementById('driveAction');
+
+    if (!data.configured) {
+      dot.className = 'dot off';

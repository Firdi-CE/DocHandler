+    }
+  }
+
+  async function connectDrive() {
+    try {
+      const res = await fetch(API_BASE + '/admin/integrations/google-drive/connect', {
+        headers: { 'Authorization': 'Bearer ' + token }
+      });
+      const data = await res.json();
+      if (res.ok && data.url) {
+        window.location.href = data.url;
+      } else {
+        showStatus(data.message || 'Failed to start the connection.', 'error');
+      }
+    } catch (e) {
+      showStatus('Network error while starting the connection.', 'error');
+    }
+  }
+
+  async function disconnectDrive() {
+    if (!confirm('Disconnect Google Drive? Existing Drive-attached documents will no longer be viewable, and new uploads will stop backing up to Drive.')) return;

+  async function loadBackfillStatus() {
+    try {
+      const res = await fetch(API_BASE + '/admin/integrations/google-drive/backfill-status', {
+        headers: { 'Authorization': 'Bearer ' + token }
+      });
+      const data = await res.json();
+      const progressEl = document.getElementById('backfillProgress');
+      const btn = document.getElementById('backfillBtn');
+      if (data.remaining === 0) {
+        progressEl.textContent = `All ${data.total} local uploads are backed up.`;
+        btn.disabled = true;
+        btn.textContent = 'Up to date';
+      } else {
+        progressEl.textContent = `${data.done} of ${data.total} local uploads backed up — ${data.remaining} remaining.`;
+        btn.disabled = false;
+        btn.textContent = 'Run Backfill';
+      }
+      return data;
+    } catch (e) {
+      document.getElementById('backfillProgress').textContent = 'Could not check backfill status.';
+      return null;
+    }
+  }
+
+  let backfillPollTimer = null;
+
+  async function runBackfill() {
+    const btn = document.getElementById('backfillBtn');
+    btn.disabled = true;
+    btn.textContent = 'Starting...';
+    try {
+      const res = await fetch(API_BASE + '/admin/integrations/google-drive/backfill', {
+        method: 'POST',
+        headers: { 'Authorization': 'Bearer ' + token }
+      });
+      const data = await res.json();
+      if (!res.ok) {
+        showStatus(data.message || 'Failed to start backfill.', 'error');
+        btn.disabled = false;
+        btn.textContent = 'Run Backfill';
+        return;
+      }
+      document.getElementById('backfillProgress').textContent = `Backfilling ${data.count} document(s) in the background...`;
+      btn.textContent = 'Running...';
+      // This runs in the background server-side with no push updates, so
+      // just poll status every few seconds until it settles.
+      clearInterval(backfillPollTimer);
+      backfillPollTimer = setInterval(async () => {
+        const status = await loadBackfillStatus();
+        if (status && status.remaining === 0) {
+          clearInterval(backfillPollTimer);
+        }
+      }, 4000);
+    } catch (e) {
+      showStatus('Network error while starting the backfill.', 'error');
+      btn.disabled = false;
+      btn.textContent = 'Run Backfill';
     }
   }
 
